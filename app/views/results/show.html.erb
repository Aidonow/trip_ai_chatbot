<main class="result-page">
  <%= link_to root_path, class: "result-back-link" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    Back to my trips
  <% end %>

  <section class="result-hero<%= " result-hero--with-image" if @result_image.present? %>">
    <% if @result_image.present? %>
      <%= image_tag @result_image,
                    class: "result-hero__image",
                    alt: "",
                    fetchpriority: "high" %>
    <% end %>
    <div class="result-hero__content">
      <p class="result-kicker">Your trip suggestion</p>
      <h1><%= @result.destination.presence || "Trip details" %></h1>
      <p class="result-hero__caption">A travel idea made just for you.</p>
    </div>
    <% unless @result_image.present? %>
      <div class="result-hero__icon" aria-hidden="true">
        <i class="fa-solid fa-location-dot"></i>
      </div>
    <% end %>
  </section>

  <section class="result-facts" aria-label="Trip overview">
    <article class="result-fact">
      <span class="result-fact__icon" aria-hidden="true"><i class="fa-solid fa-map"></i></span>
      <div>
        <p>Destination</p>
        <strong><%= @result.destination.presence || "Not specified" %></strong>
      </div>
    </article>

    <article class="result-fact">
      <span class="result-fact__icon" aria-hidden="true"><i class="fa-solid fa-wallet"></i></span>
      <div>
        <p>Estimated budget</p>
        <strong>
          <%= @result.price.present? ? number_to_currency(@result.price, unit: "€", format: "%n %u", precision: 0) : "Not specified" %>
        </strong>
      </div>
    </article>

    <article class="result-fact">
      <span class="result-fact__icon" aria-hidden="true"><i class="fa-regular fa-clock"></i></span>
      <div>
        <p>Duration</p>
        <strong><%= @result.time.present? ? pluralize(@result.time, "day") : "Not specified" %></strong>
      </div>
    </article>
  </section>

  <% if @result.content.present? %>

  <% end %>
      <section class="card shadow-sm mt-3">
        <div class="card-body p-4 p-lg-5">
          <%
            title = @result.destination.presence || "Trip details"
            destination = @result.destination.presence || "Not specified"
            price = @result.price.present? ? number_to_currency(@result.price, unit: "€", strip_insignificant_zeros: true) : "Not specified"
            duration = @result.time.present? ? pluralize(@result.time, "day") : "Not specified"

            markdown = <<~MARKDOWN
              Your trip suggestion

              # #{title}

              - **Destination:** #{destination}
              - **Price:** #{price}
              - **Duration:** #{duration}
            MARKDOWN

            if @result.content.present?
              markdown += "\n## Details\n\n#{@result.content}"
            end
          %>

          <%= sanitize(render_markdown(markdown)) %>

          <div class="d-flex justify-content-end align-items-center gap-2 mt-4">


  <div class="result-actions">
    <%= button_to "Delete trip",
                  result_path(@result),
                  method: :delete,
                  class: "result-delete-button",
                  form: { data: { turbo_confirm: "Delete this suggestion?" } } %>
    <%= link_to chat_path(@chat), class: "result-chat-button" do %>
      Continue in chat
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>
</main>
