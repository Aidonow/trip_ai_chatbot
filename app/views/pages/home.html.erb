<div class="container py-3 py-lg-5">
  <div class="d-flex flex-column align-items-center text-center gap-3 mb-4">
    <%= button_to "START", chats_path,
                  method: :post,
                  class: "btn btn-primary" %>
    <p>"Your next adventure starts with a chat"</p>
  </div>

  <h1 class="mb-0 text-center">My History</h1>

  <div class="row g-3 text-center m-2">
    <%# results = ["Suggestion 1", "Suggestion 2",  "Suggestion 3",  "Suggestion 4"] %>
    <% @results.each do |result| %>
      <div class="col-12 col-md-6 col-lg-4">
        <%= link_to result_path(result), class: "card h-100 text-decoration-none text-body" do %>
          <div class="card-body">
            <h2 class="h5 card-title"><%= result.destination %></h2>

            <p class="card-text mb-1">
              <%= pluralize(result.time.to_i, "day", "days") %>
            </p>

            <p class="card-text">
              Budget:
              <%= number_to_currency(result.price, unit: "€", format: "%n %u", precision: 0) %>
            </p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
