<div class="container py-3 py-lg-5">
  <div class="d-flex flex-column align-items-center text-center gap-3 mb-4">
    <%= button_to "START", chats_path,
                  method: :post,
                  class: "btn btn-primary" %>
    <p>"Your next adventure starts with a chat"</p>
  </div>

  <h1 class="mb-0 text-center">My History</h1>

  <div class="row g-3 text-center m-2">
    <% if @results.any? %>
      <% @results.each do |result| %>
        <div class="col-12 col-md-6 col-lg-4">
          <%= link_to result_path(result), class: "card h-100 text-decoration-none text-dark" do %>
            <article class="card-body">
              <h2 class="h5"><%= result.destination.presence || "Trip suggestion" %></h2>
              <p class="mb-0">
                <% if result.price.present? %>
                  Price: <%= number_with_precision(result.price, precision: 2, strip_insignificant_zeros: true) %>
                <% end %>
                <% if result.time.present? %>
                  <%= " · " if result.price.present? %>
                  Duration: <%= pluralize(result.time, "day") %>
                <% end %>
              </p>
            </article>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted">Your saved trip results will appear here.</p>
    <% end %>
  </div>
</div>
