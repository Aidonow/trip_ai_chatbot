<main class="home-page">
  <section class="home-hero">
    <div class="home-hero__content">
      <p class="home-kicker">Meet Aïdo, your travel copilot</p>

      <h2>Where shall we fly?</h2>

      <p class="home-description">
        Chat with Aïdo. He’ll suggest the best destination for you. Let’s do it now!
      </p>

      <%= button_to chats_path,
                    method: :post,
                    class: "home-primary-button" do %>
        Chat with me
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      <% end %>
    </div>

    <div aria-hidden="true">
    <%= image_tag "aido on plane.png",
                  alt: "Aido on plane",
                  width: 300,
                  class: "d-block mx-auto img-fluid mb-3" %>
    </div>
  </section>

  <section class="home-history">
    <div class="home-history__header">
      <div>
        <h2>My trips</h2>
      </div>

      <% if @results.any? %>
        <span class="home-trip-count"><%= pluralize(@results.count, "trip") %></span>
      <% end %>
    </div>

    <% if @results.any? %>
      <div class="home-trip-grid">
        <% @results.each do |result| %>
          <%= link_to result_path(result), class: "home-trip-card" do %>
            <div class="home-trip-card__banner">
              <% if @result_images[result].present? %>
                <%= image_tag @result_images[result],
                              alt: "#{result.destination} travel destination",
                              loading: "lazy",
                              decoding: "async" %>
              <% else %>
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <% end %>
            </div>

            <div class="home-trip-card__content">
              <div class="home-trip-card__body">
                <h3><%= result.destination %></h3>
                <p><%= pluralize(result.time.to_i, "day", "days") %></p>
              </div>

              <div class="home-trip-card__budget">
                <span>Budget</span>
                <strong><%= number_to_currency(result.price, unit: "€", format: "%n %u", precision: 0) %></strong>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="home-empty">
        <i class="fa-solid fa-suitcase-rolling" aria-hidden="true"></i>
        <div>
          <h3>No saved trips yet</h3>
          <p>Plan your first trip to see it here.</p>
        </div>
      </div>
    <% end %>
  </section>
</main>
