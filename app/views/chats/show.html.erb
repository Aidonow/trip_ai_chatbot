<div class="chat-page container-fluid px-2 px-md-4 px-lg-5"
     data-controller="chat"
     data-action="turbo:submit-start->chat#send turbo:submit-end->chat#finish"
     data-user-initial="<%= current_user.email.first.upcase %>"
     data-aido-avatar-url="<%= image_path('aido avatar.png') %>">

  <div class="chat-thread w-100">
    <div id="messages"
         class="chat-messages"
         data-chat-target="messages">
    <div id="messages" class="chat-messages" data-chat-target="messages">
      <div class="d-flex align-items-end gap-2 w-100 mb-3 justify-content-start">
        <%= image_tag "aido avatar.png", class: "avatar flex-shrink-0", alt: "" %>
        <div class="message-bubble">
          <strong>Aïdo</strong>
          <div class="trip-markdown">
            <p>
              Hello! 👋 I’m <strong>Aïdo</strong>, your travel copilot. Tell me your <strong>departure city</strong>,
              <strong>travel dates</strong>, <strong>trip duration</strong>, and <strong>budget</strong>.
              I’ll suggest the best destinations for you!
            </p>
          </div>
        </div>
      </div>

      <%= render "messages/message", messages: @messages, chat: @chat %>
    </div>
      <%= render "messages/message", messages: @messages, chat: @chat %>
    </div>

    <div id="new_message_container" class="chat-composer">
      <%= render "messages/form", chat: @chat, message: @message %>
    </div>
  </div>
</div>
