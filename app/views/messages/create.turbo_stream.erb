<%= turbo_stream.remove "destination-choices" %>

<%= turbo_stream.append "messages" do %>
  <%= render "messages/message",
             messages: [@message, @assistant_message],
             chat: @chat %>
<% end %>

<%= turbo_stream.remove "pending-message" %>

<%= turbo_stream.update "new_message_container" do %>
  <%= render "messages/form", chat: @chat, message: Message.new %>
<% end %>
