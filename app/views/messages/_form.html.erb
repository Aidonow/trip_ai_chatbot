<%= simple_form_for [chat, message] do |f| %>
  <div class="chat-input-group">
    <%= f.input_field :content,
                      as: :string,
                      class: "chat-input",
                      required: true,
                      placeholder: "I want to travel for 5 days in December with a budget of €800." %>

    <%= f.button :submit, "Send", class: "chat-send-button" %>
  </div>
<% end %>
